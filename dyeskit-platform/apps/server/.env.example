# Copy to .env (never commit .env) or set these in your host's dashboard.
PORT=4000
# PostgreSQL. Leave empty to use the embedded database in apps/server/data (local use only).
DATABASE_URL=
# Demo accounts + ~800 demo surveys on first start. Default: true locally, false with DATABASE_URL.
SEED_DEMO=
# First admin account when SEED_DEMO=false and the database has no users yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Sign-in codes by text message. Unset = phone sign-in off in production (code shown on screen in development).
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Any long random text, so sign-in codes survive a server restart.
OTP_SECRET=
# Optional: AI answers in "Ask the data" (Claude). Unset = quick rule-based answers, no cost.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=
